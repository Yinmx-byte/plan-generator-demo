# 模型提供方：anthropic / openai / deepseek
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
# 可选：自定义 API 地址（如使用代理或其他兼容服务）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 默认模型（非 DeepSeek 或未设置角色模型时的兼容配置）
# MODEL_NAME=claude-sonnet-4-6
MAX_TOKENS=16000

# AgentScope Studio / OpenTelemetry observability
AGENTSCOPE_OBSERVABILITY_ENABLED=true
AGENTSCOPE_STUDIO_URL=http://127.0.0.1:3000
# AGENTSCOPE_TRACING_URL=https://your-otlp-endpoint/v1/traces
AGENTSCOPE_PROJECT=plan-generator
AGENTSCOPE_RUN_NAME=backend
OTEL_SERVICE_NAME=plan-generator-backend

# DeepSeek 示例
# MODEL_PROVIDER=deepseek
# MASTER_MODEL_NAME=deepseek-v4-flash
# EXTRACTION_MODEL_NAME=deepseek-v4-flash
# PLAN_MODEL_NAME=deepseek-v4-pro
# PLAN_RETRY_MODEL_NAME=deepseek-v4-pro
# PLAN_RETRY_THINKING_ENABLED=true
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# RAG 可选配置：百炼知识库 API
# ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI...
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxx
# BAILIAN_WORKSPACE_ID=ws-xxx
# BAILIAN_INDEX_ID=xxx
# BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com
# BAILIAN_REGION_ID=cn-beijing
# BAILIAN_RAG_TOP_K=5
# BAILIAN_RAG_ENABLE_RERANK=true
# BAILIAN_RAG_RERANK_MIN_SCORE=0.2
# BAILIAN_EMBEDDING_MODEL_NAME=text-embedding-v4
# BAILIAN_RERANK_MODEL_NAME=qwen3-rerank-hybrid
# BAILIAN_CHUNK_SIZE=800
# BAILIAN_OVERLAP_SIZE=100
# RAG_TOP_K=5

# 阿里云只读资源查询工具（ECS/VPC，基于官方 Python SDK）
# ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI...
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxx
# ALIBABA_CLOUD_SECURITY_TOKEN=xxx
# ALIYUN_ECS_ENDPOINT=ecs.cn-beijing.aliyuncs.com
# ALIYUN_VPC_ENDPOINT=vpc.cn-beijing.aliyuncs.com
# ALIYUN_OPENAPI_CONNECT_TIMEOUT=10000
# ALIYUN_OPENAPI_READ_TIMEOUT=20000
# ALIYUN_CLOUD_QUERY_PAGE_SIZE=50
# ALIYUN_CLOUD_QUERY_MAX_VPCS=10
# ALIYUN_CMS_ENDPOINT=metrics.cn-beijing.aliyuncs.com
# ALIYUN_ECS_USAGE_METRICS=CPUUtilization
# ALIYUN_RESOURCE_CENTER_ENDPOINT=resourcecenter.aliyuncs.com
# ALIYUN_RESOURCE_CENTER_REGION_ID=cn-hangzhou

# 方案归档（RDS 保存索引与审计记录，OSS 保存 DOCX、快照和版本差异）
# ARCHIVE_RDS_HOST=rm-xxx.mysql.rds.aliyuncs.com
# ARCHIVE_RDS_PORT=3306
# ARCHIVE_RDS_DATABASE=generated_maintenance_plan
# ARCHIVE_RDS_USERNAME=archive_user
# ARCHIVE_RDS_PASSWORD=xxx
# PLAN_ARCHIVE_OSS_BUCKET=your-private-bucket
# PLAN_ARCHIVE_OSS_REGION=cn-beijing
# PLAN_ARCHIVE_OSS_PREFIX=maintenance-plan-archive
# 可选：不设置时复用 ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET
# PLAN_ARCHIVE_OSS_ACCESS_KEY_ID=LTAI...
# PLAN_ARCHIVE_OSS_ACCESS_KEY_SECRET=xxx

# 高质量检修方案参考库（复用归档 RDS，DOCX 使用独立 OSS Bucket）
# QUALITY_REFERENCE_OSS_BUCKET=high-quality-plan
# QUALITY_REFERENCE_OSS_REGION=cn-beijing
# QUALITY_REFERENCE_OSS_PREFIX=quality-references
# QUALITY_REFERENCE_TOP_K=5
# QUALITY_EVALUATOR_MODEL_NAME=deepseek-v4-pro
# QUALITY_EVALUATOR_MAX_TOKENS=6000
# 可选：不设置时复用 ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET
# QUALITY_REFERENCE_OSS_ACCESS_KEY_ID=LTAI...
# QUALITY_REFERENCE_OSS_ACCESS_KEY_SECRET=xxx
