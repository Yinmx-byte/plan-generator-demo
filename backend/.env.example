# 模型提供方：anthropic / openai / deepseek
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
# 可选：自定义 API 地址（如使用代理或其他兼容服务）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 模型选择
# MODEL_NAME=claude-sonnet-4-6

# DeepSeek 示例
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-v4-pro
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# RAG 可选配置：百炼知识库 API
# ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI...
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxx
# BAILIAN_WORKSPACE_ID=ws-xxx
# BAILIAN_INDEX_ID=xxx
# BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com
# BAILIAN_REGION_ID=cn-beijing
# BAILIAN_RAG_TOP_K=5
# BAILIAN_RAG_ENABLE_RERANK=true
# BAILIAN_RAG_RERANK_MIN_SCORE=0.2
# BAILIAN_EMBEDDING_MODEL_NAME=text-embedding-v4
# BAILIAN_RERANK_MODEL_NAME=qwen3-rerank-hybrid
# BAILIAN_CHUNK_SIZE=800
# BAILIAN_OVERLAP_SIZE=100
# RAG_TOP_K=5
